generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String?  @unique
  username         String
  password         String?
  steamId          String?  @unique
  steamDisplayName String?
  avatar           String?
  refreshToken     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}